FT_CLIENT_ID=your_uid_here
FT_CLIENT_SECRET=your_secret_here
SESSION_SECRET=any_long_random_string_used_to_sign_session_cookies
PORT=4000
# Overrides the OAuth redirect_uri's origin — needed in local dev because Vite's proxy
# rewrites the Host header to localhost:4000 before Express sees it.
APP_ORIGIN=http://localhost:5173
