FT_CLIENT_ID=your_uid_here
FT_CLIENT_SECRET=your_secret_here
SESSION_SECRET=any_long_random_string_used_to_sign_session_cookies
PORT=4000
# Optional. Only needed in production (Vercel) — Cloudflare, in front of api.intra.42.fr,
# blocks Vercel's egress IPs by ASN. A static-IP outbound proxy (QuotaGuard Static, Fixie,
# etc) routes requests through a non-blocked IP instead. Format: http://user:pass@host:port
# OUTBOUND_PROXY_URL=
